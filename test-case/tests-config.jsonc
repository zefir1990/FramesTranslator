{
  "shadowrun_cd": {
    "frames": [
      // "Actions Menu" is the main gameplay menu in Shadowrun CD
      {
        "name": "Actions Menu",
        "rect": {
          "x": 18,
          "y": 86,
          "width": 91,
          "height": 68
        }
      },
      // "Contacts" lists nearby characters in Shadowrun CD
      {
        "name": "Contacts",
        "rect": {
          "x": 146,
          "y": 86,
          "width": 75,
          "height": 68
        }
      }
    ],
    "expectedResultOCR": {
      "Actions Menu": [
        "見る",
        "話す",
        "移動",
        "アイテム"
      ],
      "Contacts": [
        "仲間",
        "通行人１",
        "通行人２",
        "通行人３"
      ]
    },
    "expectedTranslationResult": {
      "Actions Menu": [
        "See",
        "Talk",
        "Contact Us",
        "Item."
      ],
      "Contacts": [
        "Contact Us",
        "Traffic1.",
        "person 2.",
        "Traffic 3."
      ]
    },
    "timeoutSeconds": 5
  },
  "shadowrun_dialog": {
    "frames": [
      // Dialog text box shown during the Shadowrun CD intro scene
      {
        "name": "Dialog",
        "rect": {
          "x": 26,
          "y": 158,
          "width": 267,
          "height": 52
        }
      }
    ],
    "expectedResultOCR": {
      "Dialog": [
        "意外に手ごたえのない",
        "連中だったわね"
      ]
    },
    "expectedTranslationResult": {
      "Dialog": [
        "Unexpected",
        "It was a long time."
      ]
    },
    "timeoutSeconds": 5
  },
  "shadowrun_street": {
    "frames": [
      // Dialog text box shown during the Shadowrun CD Shibuya street scene
      {
        "name": "Street Dialog",
        "rect": {
          "x": 26,
          "y": 158,
          "width": 267,
          "height": 52
        }
      }
    ],
    "expectedResultOCR": {
      "Street Dialog": [
        "渋谷は",
        "とてもきらびやかな街だ"
      ]
    },
    "expectedTranslationResult": {
      "Street Dialog": [
        "Shibuya",
        "A very nice city"
      ]
    },
    "timeoutSeconds": 5
  }
}
